# Secretos del backend. Copiar a env/backend.env, completar y:
#   chmod 600 env/backend.env
# Nunca se commitea y nunca se hornea en la imagen: se inyecta al arrancar.

# Supabase. Usar el SESSION POOLER, no la conexión directa: el droplet sale por
# IPv4 y la conexión directa del plan gratis puede resolver sólo por IPv6.
# Se copia del panel de Supabase → Connect → Session pooler.
DATABASE_URL=postgresql://postgres.xxxx:CLAVE@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Clerk
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# Asistente (Gemini). Sin esto el chatbot responde 503; el resto del banco anda.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# La misma clave que env/proveedores.env
PROVEEDORES_API_KEY=orbital-proveedores-2026

# El Banco Central NO se configura acá: sus credenciales viven en la tabla
# banco_central_configuracion de Supabase (src/modules/central-bank-config.js),
# así que el droplet las lee de la base sin que haya que copiar nada.

LOG_LEVEL=info

# Conexiones simultáneas a Postgres. 10 por defecto; subirlo sólo si el pooler
# de Supabase lo aguanta.
# DB_POOL_MAX=10

# Poner en false sólo si algún día corre una segunda instancia: el sincronizador
# de transferencias entrantes tiene que correr en una sola.
# SINCRONIZAR_ENTRANTES=true
