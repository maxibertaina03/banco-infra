# Variables que usa docker compose. Copiar a .env y completar.
# El .env real NO se commitea.

# Dominio raíz (landing) y subdominio del portal.
DOMINIO=orbitalbank.com.ar
DOMINIO_APP=app.orbitalbank.com.ar

# Let's Encrypt avisa a esta dirección si un certificado está por vencer y la
# renovación automática viene fallando.
CERTBOT_EMAIL=tu-mail@ejemplo.com

# Clave PUBLICABLE de Clerk (pk_test_… o pk_live_…). Es pública por diseño: se
# hornea en el bundle del portal. La secreta va en env/backend.env.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
