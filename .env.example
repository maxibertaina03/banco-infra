# Variables que usa docker compose. Copiar a .env y completar.
# El .env real NO se commitea.

# Dominio raíz (landing) y subdominio del portal.
DOMINIO=orbital.net.ar
DOMINIO_APP=app.orbital.net.ar

# Let's Encrypt avisa a esta dirección si un certificado está por vencer y la
# renovación automática viene fallando.
CERTBOT_EMAIL=tu-mail@ejemplo.com

# Dueño de las imágenes en ghcr.io. Es el usuario u organización de GitHub
# donde viven los repos del banco.
DUENO_GHCR=maxibertaina03

# Etiqueta de imagen a usar. `latest` es la última publicada por GitHub
# Actions. Para volver a una versión concreta, poner el SHA del commit:
#   VERSION=a1b2c3d docker compose up -d backend
VERSION=latest

# OJO: la clave PUBLICABLE de Clerk ya NO va acá.
#
# Se hornea en el bundle del portal durante el build, y el build ahora pasa en
# GitHub Actions. Se configura allá, en el repo banco-frontend:
#   Settings → Secrets and variables → Actions → Variables
#   VITE_CLERK_PUBLISHABLE_KEY = pk_test_…
#
# La SECRETA (sk_…) sigue yendo en env/backend.env, acá en el servidor.
